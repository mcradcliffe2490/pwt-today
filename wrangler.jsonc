// Cloudflare Worker for https://pwt-today.com. Cloudflare's GitHub build runs
// `npx wrangler deploy` on every push to main, which builds the site first.
{
  "name": "pwt-today",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-16",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pwt-today",
      "database_id": "edb4a693-632e-4db6-a194-018b663424aa",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
